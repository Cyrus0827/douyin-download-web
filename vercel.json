{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/proxy", "dest": "/api/index.js" },
    { "src": "/api/download", "dest": "/api/index.js" },
    { "src": "/(.+)", "dest": "/$1" },
    { "src": "/", "dest": "/index.html" }
  ]
}